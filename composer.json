{
  "name": "epicwp/wp-roundtable",
  "description": "Roundtable WordPress SDK — drop-in community discussions admin for WP plugins",
  "type": "library",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "brain/monkey": "^2.6",
    "oblak/wordpress-coding-standard": "^1",
    "php-stubs/wordpress-stubs": "^6.5",
    "phpstan/extension-installer": "^1.3",
    "phpstan/phpstan": "^1.10",
    "phpstan/phpstan-deprecation-rules": "^1.1",
    "phpunit/phpunit": "^9.6",
    "szepeviktor/phpstan-wordpress": "^1.3"
  },
  "autoload": {
    "psr-4": {
      "EpicWP\\Roundtable\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "EpicWP\\Roundtable\\Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    },
    "platform": {
      "php": "8.1"
    },
    "sort-packages": true
  },
  "scripts": {
    "cs": "phpcs",
    "cs:fix": "phpcbf",
    "stan": "phpstan analyse --no-progress --memory-limit=1G",
    "test": "phpunit"
  }
}
